---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  /** 首页瀑布流需要比阅读栏更宽的中轴，导航与页脚同步放宽以保持边缘对齐 */
  wide?: boolean;
  /** 额外追加到 main 上的宽度类（如文章页三栏布局在宽屏下放宽中轴） */
  mainClass?: string;
}

const { title, description, wide = false, mainClass = '' } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <Header wide={wide} />
  <main
    class:list={[
      'mx-auto w-full flex-1 py-10',
      wide ? 'max-w-[912px] px-4' : 'max-w-3xl px-4',
      mainClass,
    ]}
  >
    <slot />
  </main>
  <Footer wide={wide} />
</BaseLayout>
