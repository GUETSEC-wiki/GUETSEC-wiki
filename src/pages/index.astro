---
import PageLayout from '../layouts/PageLayout.astro';
import { HomeHero } from '../components/blog/Hero';
import { PostMasonry } from '../components/blog/PostMasonry';
import { formatDate, getPosts, toCardData } from '../lib/posts';

const posts = await getPosts();
const latest = posts.slice(0, 6);
const tagCount = new Set(posts.flatMap((post) => post.data.tags)).size;
const categoryCount = new Set(posts.flatMap((post) => post.data.categories)).size;
const updated = formatDate(posts[0]?.data.date, 'long') || undefined;
---

<PageLayout wide title="GUETSEC Wiki">
  <HomeHero
    client:load
    postCount={posts.length}
    tagCount={tagCount}
    categoryCount={categoryCount}
    updated={updated}
  />

  <section class="mt-14">
    <div class="mb-3 flex items-baseline justify-between gap-4">
      <h2 class="text-[11px] font-medium uppercase tracking-[0.28em] text-white/50">
        最新文章
      </h2>
      <a
        href="/posts/"
        class="text-[11px] tracking-wide text-white/50 transition-colors hover:text-white/90"
      >
        全部 {posts.length} 篇 →
      </a>
    </div>
    <PostMasonry client:visible posts={toCardData(latest)} />
  </section>
</PageLayout>
