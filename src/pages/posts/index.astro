---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import { ListHero } from '../../components/blog/Hero';
import { PostGrid } from '../../components/blog/PostGrid';
import { getPosts, toCardData } from '../../lib/posts';

const posts = await getPosts();

// 左栏：全站分类（按文章数降序）；右栏：全站标签（按文章数降序）
const categoryCounts = new Map<string, number>();
const tagCounts = new Map<string, number>();
for (const post of posts) {
  for (const c of post.data.categories) categoryCounts.set(c, (categoryCounts.get(c) ?? 0) + 1);
  for (const t of post.data.tags) tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1);
}
const categories = [...categoryCounts.entries()].sort((a, b) => b[1] - a[1]);
const tags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1]);

const sideLabel = 'text-[10px] font-medium uppercase tracking-[0.3em] text-white/50';
---

<PageLayout title="文章 · GUETSEC Wiki" mainClass="min-[1200px]:max-w-[1264px]">
  <div class="mx-auto grid w-full max-w-3xl grid-cols-1 min-[1200px]:max-w-[1232px] min-[1200px]:grid-cols-[200px_minmax(0,768px)_200px] min-[1200px]:gap-8">
    <aside class="hidden min-[1200px]:block">
      <div class="sticky top-20 space-y-7 text-[13.5px]">
        <nav aria-label="全站分类">
          <p class={sideLabel}>分类</p>
          <ul class="mt-3 space-y-1.5">
            {
              categories.map(([category, count]) => (
                <li class="flex items-baseline justify-between gap-2">
                  <a
                    href={`/categories/${encodeURIComponent(category)}/`}
                    class="text-white/50 transition-colors duration-300 hover:text-white/80"
                  >
                    {category}
                  </a>
                  <span class="text-[11px] tabular-nums text-white/50">{count}</span>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </aside>

    <div>
      <ListHero
        client:load
        eyebrow="Writing"
        title="全部文章"
        count={posts.length}
        description="CTF 赛题复现、漏洞分析与安全技术笔记。"
      />

      <div class="mt-10">
        <PostGrid client:visible posts={toCardData(posts)} />
      </div>
    </div>

    <aside class="hidden min-[1200px]:block">
      <div class="sticky top-20 space-y-7 text-[13.5px]">
        <nav aria-label="全站标签">
          <p class={sideLabel}>标签</p>
          <ul class="mt-3 space-y-1.5">
            {
              tags.slice(0, 12).map(([tag, count]) => (
                <li class="flex items-baseline justify-between gap-2">
                  <a
                    href={`/tags/${encodeURIComponent(tag)}/`}
                    class="text-white/50 transition-colors duration-300 hover:text-white/80"
                  >
                    #{tag}
                  </a>
                  <span class="text-[11px] tabular-nums text-white/50">{count}</span>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </aside>
  </div>
</PageLayout>
