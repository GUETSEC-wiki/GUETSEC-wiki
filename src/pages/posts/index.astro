---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0),
);
const fmt = (d?: Date) =>
  d ? d.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' }) : '';
---

<PageLayout title="文章 · GUETSEC Wiki">
  <h1 class="mb-8 text-3xl font-bold">全部文章</h1>
  <ul class="space-y-5">
    {
      posts.map((post) => (
        <li>
          <a href={`/posts/${post.id}/`} class="group block">
            <h2 class="text-xl font-semibold group-hover:text-[var(--theme)]">
              {post.data.title}
            </h2>
            <p class="mt-1 text-sm text-[var(--text-p3)]">
              {post.data.description ?? ''}
            </p>
            <p class="mt-1 text-xs text-[var(--text-p3)]">
              {fmt(post.data.date)}
              {post.data.tags.length > 0 && ` · ${post.data.tags.map((t) => `#${t}`).join(' ')}`}
            </p>
          </a>
        </li>
      ))
    }
  </ul>
</PageLayout>
