---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
    (a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0),
  );
  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: { post, index, total: posts.length },
  }));
}

interface Props {
  post: CollectionEntry<'posts'>;
  index: number;
  total: number;
}

const { post, index, total } = Astro.props;
const { Content } = await render(post);
const { title, author, date, tags, categories, description } = post.data;
const prev = index > 0 ? (await getCollection('posts')).sort((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0))[index - 1] : undefined;
const next = index < total - 1 ? (await getCollection('posts')).sort((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0))[index + 1] : undefined;

const fmt = (d?: Date) =>
  d ? d.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' }) : '';
---

<PageLayout title={`${title} · GUETSEC Wiki`} description={description}>
  <article>
    <header class="mb-8 border-b border-[var(--border)] pb-6">
      <h1 class="text-3xl font-bold leading-tight">{title}</h1>
      <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-[var(--text-muted)]">
        <span>✍️ {author}</span>
        {date && <span>📅 <time datetime={date.toISOString()}>{fmt(date)}</time></span>}
        {
          categories.length > 0 && (
            <span>
              📁 {categories.map((c) => (
                <a href={`/categories/${encodeURIComponent(c)}/`} class="hover:text-[var(--accent)]">{c}</a>
              )).reduce((acc, el, i) => (i === 0 ? [el] : [...acc, ' / ', el]), [] as any[])}
            </span>
          )
        }
      </div>
      {
        tags.length > 0 && (
          <div class="mt-3 flex flex-wrap gap-2">
            {tags.map((t) => (
              <a
                href={`/tags/${encodeURIComponent(t)}/`}
                class="rounded-full border border-[var(--border)] bg-[var(--bg-soft)] px-2.5 py-0.5 text-xs text-[var(--text-muted)] hover:border-[var(--accent)] hover:text-[var(--accent)]"
              >
                #{t}
              </a>
            ))}
          </div>
        )
      }
    </header>

    <div class="prose-post">
      <Content />
    </div>

    <nav class="mt-12 flex justify-between gap-4 border-t border-[var(--border)] pt-6 text-sm">
      {
        next && (
          <a href={`/posts/${next.id}/`} class="text-[var(--accent)] hover:underline">
            ← {next.data.title}
          </a>
        )
      }
      {prev && <a href={`/posts/${prev.id}/`} class="ml-auto text-right text-[var(--accent)] hover:underline">{prev.data.title} →</a>}
    </nav>
  </article>
</PageLayout>
