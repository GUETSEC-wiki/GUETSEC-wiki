---
import { getCollection, render } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import { ScrollProgress } from '../../components/magicui/scroll-progress';
import { Toc } from '../../components/blog/Toc';
import { formatDate } from '../../lib/posts';

type NavItem = { id: string; title: string };
type TocHeading = { depth: number; slug: string; text: string };

export async function getStaticPaths() {
  const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
    (a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0),
  );

  return posts.map((post, index) => {
    const neighbour = (entry?: CollectionEntry<'posts'>): NavItem | undefined =>
      entry ? { id: entry.id, title: entry.data.title } : undefined;

    return {
      params: { slug: post.id },
      props: {
        post,
        newer: neighbour(posts[index - 1]),
        older: neighbour(posts[index + 1]),
        allPosts: posts,
      },
    };
  });
}

interface Props {
  post: CollectionEntry<'posts'>;
  newer?: NavItem;
  older?: NavItem;
  allPosts: CollectionEntry<'posts'>[];
}

const { post, newer, older, allPosts } = Astro.props;
const { Content, headings } = await render(post);
const { title, author, date, tags, categories, description } = post.data;
// 目录：直接取 markdown 里 # / ## / ### 生成的标题（h1–h3），由渲染器给出 slug
const toc: TocHeading[] = headings
  .filter((h) => h.depth >= 1 && h.depth <= 3)
  .map((h) => ({ depth: h.depth, slug: h.slug, text: h.text }));

const navLink =
  'group rounded-xl border border-white/[0.07] p-4 transition-colors duration-300 hover:border-white/15 hover:bg-white/[0.025]';
const navLabel = 'text-[10px] uppercase tracking-[0.28em] text-white/50';
const sideLabel = 'text-[10px] font-medium uppercase tracking-[0.3em] text-white/50';
---

<PageLayout
  title={`${title} · GUETSEC Wiki`}
  description={description}
  mainClass="min-[1200px]:max-w-[1264px]"
>
  <ScrollProgress client:load />

  <div class="mx-auto grid w-full max-w-3xl min-[1200px]:max-w-[1232px] min-[1200px]:grid-cols-[200px_minmax(0,768px)_200px] min-[1200px]:gap-8">
    <aside class="hidden min-[1200px]:block">
      <div class="sticky top-20 space-y-7 text-[13.5px]">
        <nav aria-label="全站文章">
          <p class="flex items-baseline justify-between gap-2">
            <span class={sideLabel}>全部文章</span>
            <span class="text-[11px] tabular-nums text-white/50">{allPosts.length}</span>
          </p>
          <ul class="mt-3 max-h-[calc(100vh-12rem)] space-y-2 overflow-y-auto pr-1">
            {
              allPosts.map((entry) => {
                const active = entry.id === post.id;
                return (
                  <li>
                    <a
                      href={`/posts/${entry.id}/`}
                      aria-current={active ? 'page' : undefined}
                      class:list={[
                        'block leading-snug transition-colors duration-300',
                        active
                          ? 'font-medium text-cyan-200'
                          : 'text-white/50 hover:text-white/80',
                      ]}
                    >
                      {entry.data.title}
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </nav>
      </div>
    </aside>

    <div>
      <article
        class="relative overflow-hidden rounded-2xl border border-white/[0.07] bg-[hsl(210_14%_10%)]"
      >
        <header class="reveal px-6 pb-7 pt-9 sm:px-9 sm:pt-11">
          <p class="text-[10px] uppercase tracking-[0.3em] text-white/50">WriteUp</p>
          <h1 class="text-sheen mt-4 text-balance text-[1.9rem] font-semibold leading-[1.2] tracking-tight sm:text-[2.2rem]">
            {title}
          </h1>

          <div class="mt-5 flex flex-wrap items-center gap-x-2.5 gap-y-1.5 text-[12px] text-white/55">
            <span>{author}</span>
            {
              date && (
                <time class="meta-sep tabular-nums" datetime={date.toISOString()}>
                  {formatDate(date, 'long')}
                </time>
              )
            }
            {categories.map((category) => (
              <a
                href={`/categories/${encodeURIComponent(category)}/`}
                class="meta-sep text-cyan-200/55 transition-colors hover:text-cyan-100"
              >
                {category}
              </a>
            ))}
          </div>

          {
            tags.length > 0 && (
              <div class="mt-4 flex flex-wrap items-center gap-x-3.5 gap-y-1">
                {tags.map((tag) => (
                  <a
                    href={`/tags/${encodeURIComponent(tag)}/`}
                    class="text-[11px] tracking-wide text-white/50 transition-colors hover:text-white/80"
                  >
                    #{tag}
                  </a>
                ))}
              </div>
            )
          }
        </header>

        <div class="reveal reveal-delay-1 prose-post relative border-t border-white/[0.06] px-6 pb-9 pt-8 sm:px-9">
          <Content />
        </div>
      </article>

      <nav class="mt-8 grid gap-3 sm:grid-cols-2">
        {
          older ? (
            <a href={`/posts/${older.id}/`} class={navLink}>
              <span class={navLabel}>← 下一篇</span>
              <p class="mt-2 text-sm text-white/70 transition-colors duration-300 group-hover:text-white">
                {older.title}
              </p>
            </a>
          ) : (
            <span />
          )
        }
        {
          newer && (
            <a href={`/posts/${newer.id}/`} class={`${navLink} sm:col-start-2 sm:text-right`}>
              <span class={navLabel}>上一篇 →</span>
              <p class="mt-2 text-sm text-white/70 transition-colors duration-300 group-hover:text-white">
                {newer.title}
              </p>
            </a>
          )
        }
      </nav>

      <p class="mt-10 text-center">
        <a
          href="/posts/"
          class="text-[11px] tracking-[0.2em] text-white/50 transition-colors hover:text-white/90"
        >
          ← 返回文章列表
        </a>
      </p>
    </div>

    <aside class="hidden min-[1200px]:block">
      <div class="sticky top-20">
        <Toc client:load headings={toc} />
      </div>
    </aside>
  </div>
</PageLayout>
