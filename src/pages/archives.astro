---
import { getCollection } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0),
);

const byYear = new Map<number, typeof posts>();
for (const p of posts) {
  const y = p.data.date?.getFullYear() ?? 0;
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(p);
}
const years = [...byYear.keys()].sort((a, b) => b - a);
const fmt = (d?: Date) =>
  d ? d.toLocaleDateString('zh-CN', { month: '2-digit', day: '2-digit' }) : '';
---

<PageLayout title="归档 · GUETSEC Wiki">
  <h1 class="mb-8 text-3xl font-bold">归档 <span class="text-sm font-normal text-[var(--text-p3)]">共 {posts.length} 篇</span></h1>
  {
    years.map((year) => (
      <section class="mb-10">
        <h2 class="mb-4 text-xl font-semibold text-[var(--theme)]">{year || '未标注日期'}</h2>
        <ul class="space-y-3">
          {byYear.get(year)!.map((post) => (
            <li class="flex items-baseline gap-4">
              <span class="shrink-0 text-xs text-[var(--text-p3)] tabular-nums">{fmt(post.data.date)}</span>
              <a href={`/posts/${post.id}/`} class="hover:text-[var(--theme)]">{post.data.title}</a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</PageLayout>
