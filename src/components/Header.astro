---
interface Props {
  wide?: boolean;
}

const { wide = false } = Astro.props;

const navItems = [
  { href: '/', label: '首页' },
  { href: '/posts/', label: '文章' },
  { href: '/categories/', label: '分类' },
  { href: '/tags/', label: '标签' },
  { href: '/archives/', label: '归档' },
];
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => {
  const h = href.replace(/\/$/, '') || '/';
  return h === '/' ? pathname === '/' : pathname.startsWith(h);
};
---

<header class="sticky top-0 z-10 chrome border-x-0 border-t-0">
  <div
    class:list={[
      'mx-auto flex h-14 w-full items-center justify-between',
      wide ? 'max-w-[912px] px-4' : 'max-w-3xl px-4',
    ]}
  >
    <a href="/" class="flex items-center gap-2 font-bold">
      <img src="/images/avatar.png" alt="GUETSEC" class="h-7 w-7 rounded-full" />
      <span>GUETSEC Wiki</span>
    </a>
    <nav class="flex items-center gap-1 text-sm">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              'rounded-md px-2.5 py-1.5 transition-colors',
              isActive(item.href)
                ? 'bg-[var(--theme-a20)] text-[var(--theme)] font-medium'
                : 'text-[var(--text-p3)] hover:text-[var(--text)] hover:bg-[var(--block)]',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
