---
interface Props {
  wide?: boolean;
}

const { wide = false } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="chrome border-x-0 border-b-0">
  <div
    class:list={[
      'mx-auto flex w-full flex-col items-center gap-1 py-6 text-sm text-[var(--text-p3)]',
      wide ? 'max-w-[912px] px-4' : 'max-w-3xl px-4',
    ]}
  >
    <p>© {year} GUETSEC · Powered by Astro</p>
    <p>
      <a
        href="https://github.com/GUETSEC-wiki"
        target="_blank"
        rel="noopener"
        class="hover:text-[var(--theme)]"
        >GitHub</a
      >
      <span class="mx-1.5">·</span>
      <a href="/rss.xml" class="hover:text-[var(--theme)]">RSS</a>
    </p>
  </div>
</footer>
